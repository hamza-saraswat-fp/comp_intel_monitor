# Firecrawl API key — monitoring requires a paid tier
FIRECRAWL_API_KEY=

# Email that receives monitor notifications (Week-1 signal validation)
ALERT_EMAIL=

# The deployed receiver's webhook endpoint (https://<railway-domain>/webhooks/firecrawl).
# Monitors deliver here; re-run `npm run create-monitors` after changing it.
# (Legacy fallback: WEBHOOK_SITE_URL, the old webhook.site capture sink.)
WEBHOOK_URL=

# Schedule for the committed config
MONITOR_SCHEDULE=daily

# Timezone for the schedule
MONITOR_TIMEZONE=UTC

# Set to true to trigger an immediate check on each monitor (for verification),
# instead of waiting for the daily schedule. Leave blank for normal runs.
RUN_NOW=

# ── Managed Agent (the "brain", Issue 2.x) ──────────────────────────────────
# Anthropic API key with Managed Agents beta access.
ANTHROPIC_API_KEY=

# The live agent id (agent_…) from creating agent.yaml in the Console / `ant beta:agents create`.
AGENT_ID=

# The environment id (the sandbox config sessions run in). Create one once (cloud default).
ENVIRONMENT_ID=

# The Memory Store id (memstore_…). seed-memory.ts creates one and prints this if unset.
MEMORY_STORE_ID=
# Name used only when seed-memory.ts creates a new store (default: competitor-intel).
MEMORY_STORE_NAME=

# Slack delivery — the RUNNER posts briefs via chat.postMessage (the hosted Slack MCP
# only supports interactive OAuth, so it can't be used by a headless agent).
# Bot token (xoxb-…) with chat:write; invite the bot to the channel.
SLACK_BOT_TOKEN=
# Channel name (#competitor-ai) or ID (C0…). Defaults to #competitor-ai.
SLACK_CHANNEL=

# ── Receiver (src/server.ts, AIO-162) ───────────────────────────────────────
# Account-level webhook signing secret — Firecrawl dashboard → Advanced tab.
FIRECRAWL_WEBHOOK_SECRET=
# Port the receiver listens on (Railway injects PORT automatically).
PORT=
# Max simultaneous agent sessions (default 3) — bounds cost under webhook bursts.
MAX_CONCURRENT_SESSIONS=
